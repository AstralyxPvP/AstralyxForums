{
  "name": "astralyx-forums",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "./dist" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astralyx-db",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ]
}
